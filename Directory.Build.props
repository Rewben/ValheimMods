<Project>
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
    <ReferenceRoot>$(SolutionDir).references</ReferenceRoot>
    <ManagedDataPath Condition="'$(ManagedDataPath)' == ''">$(ReferenceRoot)</ManagedDataPath>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(ReferenceRoot)</BepInExPath>
  </PropertyGroup>
</Project>
