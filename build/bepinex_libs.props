<Project>
    <PropertyGroup Condition="'$(ManagedDataPath)' == ''">
        <BepInExPath>$(ReferenceRoot)</BepInExPath>
        <ManagedDataPath>$(ReferenceRoot)</ManagedDataPath>
    </PropertyGroup>
    <ItemGroup Label="BepInEx">
        <Reference Include="0Harmony">
            <SpecificVersion>False</SpecificVersion>
            <HintPath>$(BepInExPath)\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="BepInEx">
            <SpecificVersion>False</SpecificVersion>
            <HintPath>$(BepInExPath)\BepInEx.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>